# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Only if the API says "key is not scoped to a workspace": the workspace id (wrk_...) from the Console.
# Better: create the key inside a workspace, then leave this empty.
ANTHROPIC_WORKSPACE_ID=
MODEL=claude-sonnet-5-5

# true = return fixed example responses, no Claude calls (for frontend work / no credits)
MOCK_AI=false

# Comma-separated origins the frontend runs on
CORS_ORIGINS=http://localhost:8443,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Demo-only staff access (the Kita code is the password). Not real security.
KITA_CODE=SONNE
STAFF_TOKEN=demo-staff-token

# Optional: pin "today" for the week board so the demo is reproducible (YYYY-MM-DD)
DEMO_TODAY=2026-11-09
